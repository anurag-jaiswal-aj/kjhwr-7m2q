# ==============================================================================
# Gridbricks | Wind Intelligence - Environment Configuration Template
# ==============================================================================

# Backend Service Configuration
PORT=8000
DATABASE_PATH=backend/data/analytics.db

# Docker Compose Host Port Overrides (Optional)
BACKEND_PORT=8001
FRONTEND_PORT=3001

# CORS Configuration (Comma-separated allowed origins)
# For local development and container deployments:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173

# Elexon BMRS API Client Configuration (Used only for out-of-band ingestion)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3
ELEXON_BACKOFF_FACTOR=1.0

# Frontend Configuration
# Optional override for remote API deployments (defaults to /api via proxy):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
